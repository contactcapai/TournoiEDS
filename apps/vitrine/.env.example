# apps/vitrine — variables d'environnement (modele). Aucun secret commite (AR-SEC4).
# Copier en `.env.local` (ignore par git) et renseigner les vraies valeurs en local.
# Les variables exposees au navigateur DOIVENT etre prefixees NEXT_PUBLIC_.

# URL publique de base du site (utilisee plus tard pour SEO/metadata canoniques).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Connexion Postgres (Drizzle) — base `vitrine` du Postgres mutualise (revision 2026-07-29).
# Modele de chaine, SANS secret : renseigner la vraie valeur en `.env.local` (jamais commite).
# Server-only : ne JAMAIS prefixer NEXT_PUBLIC_ (l'URL contient des identifiants).
#
# EN DEVELOPPEMENT (Story 3.1), le conteneur docker/docker-compose.dev.yml fournit la base :
#   docker compose -f docker/docker-compose.dev.yml up -d
#   DATABASE_URL=postgresql://vitrine:vitrine@localhost:5434/vitrine
# Port 5434 : 5432 / 5433 / 5442 sont pris par d'autres projets du poste, et le conteneur
# `tournoi-pg` (Postgres 16 de l'app tournoi) ne publie aucun port vers l'hote.
DATABASE_URL=postgresql://user:password@host:5432/dbname
